---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero { padding: 2rem 0 1rem; }
			.hero h1 { margin: 0 0 0.4rem; font-size: 2.4rem; }
			.hero .tag { color: rgb(var(--gray)); font-size: 1.15rem; margin: 0; }
			.hero .lede { margin-top: 1.2rem; max-width: 60ch; }
			.hero .cta { margin-top: 1.5rem; }
			.hero .cta a {
				display: inline-block; padding: 0.5rem 1rem; border-radius: 8px;
				background: var(--accent); color: white; text-decoration: none; font-weight: 600;
			}
			hr { border: none; border-top: 1px solid rgb(var(--gray-light)); margin: 2.5rem 0; }
			.posts { list-style: none; margin: 0; padding: 0; }
			.posts li { margin-bottom: 1.6rem; }
			.posts a { text-decoration: none; }
			.posts h3 { margin: 0 0 0.2rem; }
			.posts .date { color: rgb(var(--gray)); font-size: 0.9rem; }
			.posts .desc { color: rgb(var(--gray-dark)); margin: 0.3rem 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Building in the open.</h1>
				<p class="tag">Alex Trandafir — cybersecurity &amp; identity engineering.</p>
				<p class="lede">
					I'm a cybersecurity student working toward a career in Identity &amp; Access
					Management. This is where I document what I build in my homelab — the wins, and
					the parts that broke. Real projects, honest write-ups, no buzzword bingo.
				</p>
				<p class="cta"><a href="/blog">Read the journal →</a></p>
			</section>

			<hr />

			<h2>Latest posts</h2>
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<h3>{post.data.title}</h3>
						</a>
						<span class="date"><FormattedDate date={post.data.pubDate} /></span>
						<p class="desc">{post.data.description}</p>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
